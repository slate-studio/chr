source "https://rubygems.org"

ruby "<%= Chr::RUBY_VERSION %>"

gem 'rails', "<%= Chr::RAILS_VERSION %>"


# ASSETS --------------------------------------------------
gem 'sass-rails'
gem 'compass-rails', '~> 2.0.0'
gem 'uglifier',      '>= 1.3.0'
gem 'coffee-rails'
gem 'jquery-rails',  '4.0.2'
gem 'modernizr-rails'
gem 'marionette-rails'
gem 'turbolinks'
gem 'rails-backbone'

gem 'jbuilder', '~> 2.0'


# ORM -----------------------------------------------------
gem 'mongoid', '~> 4.0.0'
gem 'mongoid-tree'
gem 'mongoid-enum'
gem 'mongoid-autoinc'
gem 'mongoid_search'
gem 'mongoid-slug'
gem 'mongoid-history'
gem 'carrierwave-mongoid'


# GENERAL -------------------------------------------------
gem 'devise'
gem 'kaminari'
gem 'simple_form'
gem 'nested_form'
gem 'asset_sync'
gem 'sitemap_generator'
gem 'meta-tags', github: 'slate-studio/meta-tags', branch: 'hotfix/broken_special_chars'
gem 'delayed_job_mongoid'
gem 'dalli'
gem 'faker'
gem 'rack-cors', :require => 'rack/cors'
gem 'rack-attack'
gem 'rack-rewrite'
gem 'rack-cache'
gem 'nokogiri'
gem 'builder', '~> 3.2.2'
gem 'high_voltage'


# ADMIN ===================================================
gem 'formagic',   github: 'slate-studio/formagic'
gem 'chr',        github: 'slate-studio/chr',       :branch => 'feature/rb-add-generators'
gem 'inverter',   github: 'slate-studio/inverter'
gem 'mongosteen', github: 'slate-studio/mongosteen'
gem 'ants',       github: 'slate-studio/ants'
gem 'loft',       github: 'slate-studio/loft'


group :development, :test do
  gem 'awesome_print'
  gem "factory_girl_rails"
end


group :test do
  gem 'ruby-prof'
  gem 'database_cleaner', '1.0.1'
  gem 'minitest-reporters'
  gem 'minitest-focus'
  gem 'mocha'
  gem 'capybara'
  gem 'capybara-webkit'
  gem 'capybara-screenshot'
end


group :development do
  gem 'quiet_assets'
  gem 'sqlite3'
  gem 'spring'
end


